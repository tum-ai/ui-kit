{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(bun run lint)",
      "Bash(bun run typecheck)",
      "Bash(bun run format:check)",
      "Bash(bun run test)",
      "Bash(bun run test:*)",
      "Bash(bun run manifests)",
      "Bash(bunx vitest run *)",
      "Bash(bunx eslint *)",
      "Bash(bunx prettier --check *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./.vercel/**)",
      "Bash(git push *--force*)",
      "Bash(npm publish*)",
      "Bash(bun publish*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-edit.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
