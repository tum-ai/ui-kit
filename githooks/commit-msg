#!/bin/sh
set -eu
node --input-type=module - "$1" <<'JS'
import {readFileSync} from 'node:fs';
const title=readFileSync(process.argv[2],'utf8').split('\n')[0];
if(title.length>72||!/^(feat|fix|refactor|perf|test|docs|build|ci|chore|style|revert)(\([\w-]+\))?!?: [a-z].+[^.]$/.test(title)){console.error('Use a Conventional Commit subject, <=72 characters, lowercase summary.');process.exit(1);}
JS
