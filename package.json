{
  "name": "@tum-ai/ui-kit",
  "version": "0.1.0",
  "description": "TUM.ai components, visual foundations and accessible Next.js patterns.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "24.x"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tum-ai/ui-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "BRAND-ASSETS.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./tailwind.css": "./dist/styles/tailwind.css",
    "./fonts.css": "./dist/styles/fonts.css",
    "./shell.css": "./dist/styles/shell.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build": "node scripts/build.mjs",
    "build:storybook": "node scripts/generate-api.mjs && storybook build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project dom",
    "test:coverage": "vitest run --project unit --project dom --coverage",
    "test:stories": "vitest run --project stories",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "test:consumer": "node scripts/test-consumer.mjs",
    "manifests": "node scripts/manifests.mjs",
    "render:design": "node scripts/render-design.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "verify": "bun run lint && bun run format:check && bun run typecheck && bun run test:coverage && bun run build && bun run build:storybook && bun run manifests && bun run test:stories && bun run test:e2e && bun run test:consumer",
    "prepare": "node scripts/install-hooks.mjs",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "next": "^16.3.6",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tailwindcss/typography": "0.5.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "13.5.0",
    "lucide-react": "1.48.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/jsdom": "30.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vite": "8.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next": "16.3.6",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.71.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-storybook": "10.6.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "lint-staged": "16.2.7",
    "@changesets/cli": "3.0.3",
    "postcss": "8.5.8",
    "typescript-language-server": "5.1.3",
    "storybook": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-vitest": "10.6.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  }
}
